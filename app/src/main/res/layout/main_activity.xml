<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F3F6FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nickname card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/text_label_nickname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gracz:"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/nickname"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#888888"
                tools:text="Snack" />
        </LinearLayout>

        <!-- Stats title -->
        <TextView
            android:id="@+id/text_stats_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Statystyki Solo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A73E8"
            android:layout_marginBottom="16dp" />

        <!-- Stats card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background"
            android:elevation="4dp">

            <!-- Kills row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/text_label_kills"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zabójstwa (Kills):"
                    android:textSize="18sp"
                    android:textColor="#444444" />

                <TextView
                    android:id="@+id/kills"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    tools:text="12500" />
            </LinearLayout>

            <!-- Wins row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/text_label_wins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wygrane (Wins):"
                    android:textSize="18sp"
                    android:textColor="#444444" />

                <TextView
                    android:id="@+id/wins"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    tools:text="540" />
            </LinearLayout>

            <!-- Matches row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/text_label_matches"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rozegrane Mecze:"
                    android:textSize="18sp"
                    android:textColor="#444444" />

                <TextView
                    android:id="@+id/matches"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_weight="1"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    tools:text="8120" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#D32F2F"
            android:textSize="16sp"
            android:layout_marginTop="12dp" />

    </LinearLayout>

</ScrollView>
